{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-deadlines",
  "compatibility_date": "2026-11-23",
  // Deploys run only in GitHub Actions (.github/workflows/ci.yml: push to main → prod, push to dev → dev).
  // Manual deploys are forbidden; see AGENTS.md. Only the built app (./dist) is published.
  "assets": {
    "directory": "./dist"
  },
  // Keep the old *.workers.dev URL live so data in its localStorage can still be exported.
  "workers_dev": true,
  // Served at study.danielperr.com (DNS zone on Cloudflare; domain registered in AWS Route 53).
  "routes": [
    { "pattern": "study.danielperr.com", "custom_domain": true }
  ],
  "env": {
    // Dev stage: GitHub Actions runs `wrangler deploy --env dev` on every push to
    // the dev branch, publishing a separate Worker (study-deadlines-dev) on
    // workers.dev only. Routes stay empty so it can never take over the
    // production domain.
    "dev": {
      "name": "study-deadlines-dev",
      "workers_dev": true,
      "routes": []
    }
  }
}
