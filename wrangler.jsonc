{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-deadlines",
  "compatibility_date": "2026-11-23",
  // Only the built app is published; run `npm run build` first (npm run deploy does).
  "assets": {
    "directory": "./dist"
  },
  // Keep the old *.workers.dev URL live so data in its localStorage can still be exported.
  "workers_dev": true,
  // Served at study.danielperr.com (DNS zone on Cloudflare; domain registered in AWS Route 53).
  "routes": [
    { "pattern": "study.danielperr.com", "custom_domain": true }
  ],
  "env": {
    // Review stage: `npm run deploy:review` publishes to a separate Worker
    // (study-deadlines-review) on workers.dev only. Routes are cleared so it
    // can never take over the production domain.
    "review": {
      "name": "study-deadlines-review",
      "workers_dev": true,
      "routes": []
    }
  }
}
